# Copy to backend/.env (or export in your shell). Every setting is prefixed CLOUDSHIELD_.

# Local default is SQLite; docker-compose switches this to PostgreSQL.
CLOUDSHIELD_DATABASE_URL=sqlite:///./data/cloudshield.db
# CLOUDSHIELD_DATABASE_URL=postgresql+psycopg://cloudshield:cloudshield@localhost:5432/cloudshield

# Where raw (pre-normalization) events are preserved as forensic evidence: "local" or "s3".
CLOUDSHIELD_EVIDENCE_BACKEND=local
CLOUDSHIELD_EVIDENCE_DIR=./data/evidence
# CLOUDSHIELD_EVIDENCE_BACKEND=s3
# CLOUDSHIELD_EVIDENCE_BUCKET=cloudshield-evidence-<your-account-id>

# AWS access for the collectors. Use a named profile for a sandbox account, never root keys.
CLOUDSHIELD_AWS_REGION=ap-south-1
# CLOUDSHIELD_AWS_PROFILE=cloudshield-lab

# ---- Authentication ----
# First admin. If unset, a random password is generated and printed once in the backend log.
# CLOUDSHIELD_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
# Signing key for access tokens; if unset a random one is used per process (logins end on restart).
# CLOUDSHIELD_JWT_SECRET=<long random string>

# ---- Response ----
# dry_run (default) records API calls without sending them. live needs a write-scoped profile and
# enforces the two-person rule (approver != executor).
# CLOUDSHIELD_RESPONSE_MODE=live
# CLOUDSHIELD_RESPONDER_PROFILE=cloudshield-responder

# ---- Extra ingestion paths (see infrastructure/aws) ----
# CLOUDSHIELD_TRAIL_BUCKET=cloudshield-<account>-trail
# CLOUDSHIELD_VPC_FLOW_LOG_GROUP=/cloudshield/vpc-flow
# CLOUDSHIELD_SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account>/cloudshield-events
# CLOUDSHIELD_SCHEDULE_COLLECT_MINUTES=15

# ---- Optional Neo4j export (docker compose --profile graph up) ----
# CLOUDSHIELD_NEO4J_URI=bolt://neo4j:7687
# CLOUDSHIELD_NEO4J_PASSWORD=change-me-neo4j
